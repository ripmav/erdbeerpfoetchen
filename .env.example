# Set to "local-db" to start a bundled PostgreSQL container.
# Leave empty (or remove this file) to use an external database
# configured via database.uri in config.yaml.
COMPOSE_PROFILES=local-db

# Docker image tag to deploy. Defaults to "latest" when not set.
IMAGE_TAG=latest

# Goose CLI configuration for running migrations outside of Docker.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/postgres
GOOSE_MIGRATION_DIR=./schema/migrations
